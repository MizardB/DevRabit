# RCDEV: include AFTER project() so the Arduino component exists.
if(CONFIG_BT_SSP_ENABLED OR NOT CONFIG_BT_SPP_ENABLED OR NOT CONFIG_AUTOSTART_ARDUINO)
    message(FATAL_ERROR "RCDEV requires Arduino autostart, Classic SPP and SSP disabled")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/arduino-component.cmake")
if(DEFINED RCDEV_ARDUINO_COMPONENT)
    set(_arduino_comp "${RCDEV_ARDUINO_COMPONENT}")
else()
    set(_arduino_comp "${DEVRABIT_ARDUINO_COMPONENT}")
endif()
idf_component_get_property(arduino_dir "${_arduino_comp}" COMPONENT_DIR)
idf_component_get_property(arduino_lib "${_arduino_comp}" COMPONENT_LIB)
set(original "${arduino_dir}/libraries/BluetoothSerial/src/BluetoothSerial.cpp")
set(adapted "${CMAKE_BINARY_DIR}/rcdev/BluetoothSerial.cpp")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/rcdev")
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/../scripts/bluetooth.py"
    "${original}" "${adapted}" RESULT_VARIABLE patch_result)
if(NOT patch_result EQUAL 0)
    message(FATAL_ERROR "Pinned BluetoothSerial adaptation failed")
endif()
get_target_property(arduino_sources ${arduino_lib} SOURCES)
list(FIND arduino_sources "${original}" original_index)
if(original_index EQUAL -1)
    message(FATAL_ERROR "Arduino BluetoothSerial source missing from component")
endif()
list(REMOVE_ITEM arduino_sources "${original}")
list(APPEND arduino_sources "${adapted}")
set_property(TARGET ${arduino_lib} PROPERTY SOURCES "${arduino_sources}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/../scripts/bluetooth.py" "${original}")
